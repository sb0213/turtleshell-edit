{
  "manifest_version": 3,
  "name": "TurtleShell",
  "version": "5.4",
  "description": "Posture-responsive visual feedback for everyday browsing.",
  "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
  "permissions": ["storage", "sidePanel", "tabs", "offscreen", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open TurtleShell" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["camera-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
